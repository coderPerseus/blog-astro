---
import PageLayout from "@/layouts/Base.astro";
import { getLangFromRequest, t } from "@/utils/i18n";

const lang = getLangFromRequest(Astro.url);
const meta = {
	description: t("404.message", lang),
	title: t("404.title", lang),
};
---

<PageLayout lang={lang} meta={meta}>
	<h1 class="title mb-8">404</h1>
	<p class="mb-2 text-xl font-semibold text-accent-2">{t("404.heading", lang)}</p>
	<p class="mb-8 text-muted">{t("404.message", lang)}</p>
</PageLayout>
