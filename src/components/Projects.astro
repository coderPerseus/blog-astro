---
type Project = {
	url: string;
	icon: string;
	name: {
		zh: string;
		en: string;
	};
	description: {
		zh: string;
		en: string;
	};
	tags: string[];
};

import { type Lang, t } from "@/utils/i18n";

interface Props {
	lang?: Lang;
}

const { lang = "zh" } = Astro.props;

const projects: Project[] = [
	{
		url: "https://cocotranslate.com/",
		icon: "/projects/cocotranslate.png",
		name: {
