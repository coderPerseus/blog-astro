---
type Project = {
	url: string;
	icon: string;
	iconWidth?: number;
	iconHeight?: number;
	tone: "green" | "blue" | "violet" | "red" | "cyan" | "amber";
	name: {
		zh: string;
		en: string;
	};
	description: {
		zh: string;
		en: string;
	};
	tags: string[];
};

import { type Lang, t, withBase } from "@/utils/i18n";

interface Props {
	lang?: Lang;
}

const { lang = "zh" } = Astro.props;

const projects: Project[] = [
