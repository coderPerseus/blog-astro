---
import { Icon } from "astro-icon/components";
import { type Lang, t } from "@/utils/i18n";

interface Props {
	lang?: Lang;
}

const { lang = "zh" } = Astro.props;

/**
	Uses https://www.astroicon.dev/getting-started/
	Find icons via guide: https://www.astroicon.dev/guides/customization/#open-source-icon-sets
	Only installed pack is: @iconify-json/mdi
*/
const socialLinks: {
	friendlyName: string;
	isWebmention?: boolean;
	link: string;
	name: string;
}[] = [
	{
		friendlyName: "GitHub",
		link: "https://github.com/coderPerseus",
		name: "mdi:github",
	},
	{
		friendlyName: "小红书",
		link: "https://www.xiaohongshu.com/user/profile/5e2d938d000000000100ac82",
		name: "xiaohongshu",
	},
	{
		friendlyName: "哔哩哔哩",
		link: "https://space.bilibili.com/1695997565",
		name: "bilibili",
	},
];
---

<div class="flex flex-wrap items-center gap-x-3">
	<p class="eyebrow">{t("social.find_me", lang)}</p>
	<ul class="flex flex-1 items-center gap-x-2 sm:flex-initial">
		{
			socialLinks.map(({ friendlyName, isWebmention, link, name }) => (
				<li class="flex">
					<a
						class="text-muted hover:text-accent hover:bg-surface inline-grid size-9 place-items-center rounded-md transition-colors"
						href={link}
						rel={`noreferrer ${isWebmention ? "me authn" : ""}`}
						target="_blank"
					>
						<Icon aria-hidden="true" class="h-5 w-5" focusable="false" name={name} />
						<span class="sr-only">{friendlyName}</span>
					</a>
				</li>
			))
		}
	</ul>
</div>
