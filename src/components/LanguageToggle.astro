---
import { type Lang, switchLangPath, t } from "@/utils/i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const nextLang: Lang = lang === "zh" ? "en" : "zh";
const nextPath = `${switchLangPath(Astro.url.pathname, nextLang)}${Astro.url.search}`;
---

<a
	aria-label={t("lang.switch", lang)}
	class="text-muted hover:text-accent relative ms-1 inline-flex h-9 min-w-11 items-center justify-center rounded-md px-3 text-xs font-semibold transition-colors hover:bg-surface sm:ms-2"
	href={nextPath}
	hreflang={nextLang === "zh" ? "zh-CN" : "en"}
	lang={nextLang === "zh" ? "zh-CN" : "en"}
	title={t("lang.switch", lang)}
>
	{t("lang.label", lang)}
</a>
