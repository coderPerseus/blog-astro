---
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";
import {
	getMenuLinks,
	getOgLocale,
	type Lang,
	stripBaseFromPath,
	stripLangFromPath,
	t,
	withBase,
	withLangPath,
} from "@/utils/i18n";
import "@/styles/global.css";

type Props = SiteMeta & {
	lang: Lang;
};

const { articleDate, description, lang, ogImage, title } = Astro.props;

const titleSeparator = "•";
const localizedSiteTitle = t("site.title", lang);
const siteTitle = `${title} ${titleSeparator} ${localizedSiteTitle}`;
const canonicalURL = new URL(stripBaseFromPath(Astro.url.pathname), siteConfig.url);
const socialImageURL = new URL(withBase(ogImage ? ogImage : "/social-card.png"), Astro.site).href;
const alternatePath = stripLangFromPath(Astro.url.pathname);
---

<meta charset="utf-8" />
<meta content="width=device-width, initial-scale=1.0" name="viewport" />
<title>{siteTitle}</title>

{/* Icons */}
<link href={withBase("/favicon.ico")} rel="icon" sizes="any" />
<link href={withBase("/apple-icon.jpg")} rel="apple-touch-icon" />
<link href={withBase("/site.webmanifest")} rel="manifest" />

{/* Search Engine Verification */}
<meta content="codeva-7AmpPWgzQY" name="baidu-site-verification" />
<meta content="TTbfOvWmLj0icfk0BQNUZB3crwReji82Q_vRdnZFFAc" name="google-site-verification" />

{/* Canonical URL */}
<link href={canonicalURL} rel="canonical" />
<link
	href={new URL(withLangPath(alternatePath, "zh"), siteConfig.url)}
	hreflang="zh-CN"
	rel="alternate"
/>
<link
	href={new URL(withLangPath(alternatePath, "en"), siteConfig.url)}
	hreflang="en"
	rel="alternate"
/>
<link
	href={new URL(withLangPath(alternatePath, "zh"), siteConfig.url)}
	hreflang="x-default"
	rel="alternate"
/>

{/* Primary Meta Tags */}
<meta content={siteTitle} name="title" />
<meta content={description} name="description" />
<meta content={siteConfig.author} name="author" />

{/* Open Graph / Facebook */}
<meta content={articleDate ? "article" : "website"} property="og:type" />
<meta content={title} property="og:title" />
<meta content={description} property="og:description" />
<meta content={canonicalURL} property="og:url" />
<meta content={localizedSiteTitle} property="og:site_name" />
<meta content={getOgLocale(lang)} property="og:locale" />
<meta content={socialImageURL} property="og:image" />
<meta content="1200" property="og:image:width" />
<meta content="630" property="og:image:height" />
{
	articleDate && (
		<>
			<meta content={siteConfig.author} property="article:author" />
			<meta content={articleDate} property="article:published_time" />
		</>
	)
}

{/* Twitter */}
<meta content="summary_large_image" property="twitter:card" />
<meta content={canonicalURL} property="twitter:url" />
<meta content={title} property="twitter:title" />
<meta content={description} property="twitter:description" />
<meta content={socialImageURL} property="twitter:image" />

{/* Sitemap */}
<link href={withBase("/sitemap-index.xml")} rel="sitemap" />

{/* RSS auto-discovery */}
<link
	href={withBase("/rss.xml")}
	title={getMenuLinks(lang).at(-1)?.title ?? "RSS"}
	rel="alternate"
	type="application/rss+xml"
/>

<meta content={Astro.generator} name="generator" />
