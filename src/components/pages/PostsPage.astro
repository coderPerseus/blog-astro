---
import { type CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { getAllPostsByLang, getUniqueTagsWithCount } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import { type Lang, t, withBase, withLang } from "@/utils/i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
type PostLike = CollectionEntry<"post"> | CollectionEntry<"postEn">;
const allPosts = (await getAllPostsByLang(lang)) as PostLike[];
const allPostsByDate = [...allPosts].sort(collectionDateSort);
const tagsWithCount = getUniqueTagsWithCount(allPosts);

const meta = {
	description: t("posts.description", lang),
	title: t("posts.title", lang),
};

const postsByYear = allPostsByDate.reduce((groups, post) => {
	const year = post.data.publishDate.getFullYear().toString();
	const group = groups.get(year) ?? [];
	group.push(post);
	groups.set(year, group);
	return groups;
}, new Map<string, PostLike[]>());

const timelineGroups = Array.from(postsByYear, ([year, posts]) => ({ posts, year }));

function formatTimelineDate(date: Date) {
	const month = String(date.getMonth() + 1).padStart(2, "0");
	const day = String(date.getDate()).padStart(2, "0");
	return `${month}-${day}`;
}

function yearCountLabel(count: number) {
	return lang === "zh" ? `${count} 篇` : `${count} ${t("posts.count_suffix", lang)}`;
}

const INITIAL_BATCH = 20;
---

<PageLayout lang={lang} meta={meta}>
	<header class="mb-6 flex items-center justify-between gap-4 sm:mb-10">
		<div>
			<h1 class="title text-2xl sm:text-3xl">{t("posts.title", lang)}</h1>
			<p class="text-muted mt-1.5 text-sm sm:mt-2">
				{
					lang === "zh"
						? `共 ${allPostsByDate.length} 篇 · ${t("posts.sort_hint", lang)}`
						: `${allPostsByDate.length} ${t("posts.count_suffix", lang)} · ${t("posts.sort_hint", lang)}`
				}
			</p>
		</div>
		<a
			class="text-muted hover:text-accent hover:bg-surface inline-flex h-9 w-9 items-center justify-center rounded-md transition-colors"
			href={withBase("/rss.xml")}
			target="_blank"
		>
			<span class="sr-only">RSS feed</span>
			<Icon aria-hidden="true" class="h-5 w-5" focusable="false" name="mdi:rss" />
		</a>
	</header>

	<div
		class="posts-shell grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_17rem] lg:items-start lg:gap-10"
	>
		<section
			aria-label={t("posts.title", lang)}
			class="order-2 min-w-0 lg:order-none lg:col-start-1 lg:row-start-1"
		>
			<div class="space-y-8" id="posts-list" role="list">
				{
					timelineGroups.map((group) => (
						<section
							aria-label={`${group.year} ${t("posts.title", lang)}`}
							class="timeline-year"
							data-year={group.year}
							role="listitem"
						>
							<header class="timeline-year-heading flex items-baseline gap-2.5">
								<h2 class="text-accent-2 text-2xl font-bold tracking-normal tabular-nums sm:text-3xl">
									{group.year}
								</h2>
								<span class="text-muted text-xs sm:text-sm">
									{yearCountLabel(group.posts.length)}
								</span>
							</header>

							<ul class="timeline-posts" role="list">
								{group.posts.map((post) => {
									const index = allPostsByDate.indexOf(post);
									const isoDate = post.data.publishDate.toISOString();

									return (
										<li
											class="post-item timeline-item timeline-row"
											data-tags={post.data.tags.join("|")}
											data-index={index}
											style={index >= INITIAL_BATCH ? "display:none" : undefined}
										>
											<time
												class="text-muted text-sm font-medium tabular-nums"
												datetime={isoDate}
												title={isoDate}
											>
												{formatTimelineDate(post.data.publishDate)}
											</time>
											<span aria-hidden="true" class="timeline-node" />
											<div class="min-w-0">
												<a
													class="hover:text-accent hover:decoration-accent inline text-base break-words underline decoration-transparent underline-offset-4 transition-colors"
													href={withLang(`/posts/${post.id}`, lang)}
												>
													{post.data.draft && <span class="text-red-500">(Draft) </span>}
													{post.data.title}
												</a>
											</div>
										</li>
									);
								})}
							</ul>
						</section>
					))
				}
			</div>
			<div class="text-muted mt-8 hidden text-center text-sm" data-state="end" id="posts-end">
				{t("posts.end", lang)}
			</div>
			<div class="text-muted mt-8 hidden text-center text-sm" data-state="empty" id="posts-empty">
				{t("posts.empty", lang)}
			</div>
			<div aria-hidden="true" id="scroll-sentinel" class="h-px"></div>
		</section>

		<aside
			class="posts-tags order-1 min-w-0 lg:sticky lg:top-24 lg:order-none lg:col-start-2 lg:row-start-1"
			aria-label={t("posts.tags", lang)}
		>
			<div class="mb-2 flex items-baseline justify-between gap-3 sm:mb-3">
				<h2 class="eyebrow">{t("posts.tags", lang)}</h2>
			</div>
			<ul
				class="tag-filters flex gap-2 overflow-x-auto pb-1 lg:flex-wrap lg:gap-2.5 lg:overflow-visible lg:pb-0"
				id="tag-filters"
				role="list"
			>
				<li class="shrink-0 lg:shrink">
					<a class="tag-chip is-active" data-tag="" href={withLang("/posts", lang)}>
						{t("posts.all", lang)}
						<span class="text-muted">{allPostsByDate.length}</span>
					</a>
				</li>
				{
					tagsWithCount.map(([tag, count]) => (
						<li class="shrink-0 lg:shrink">
							<a
								class="tag-chip"
								data-tag={tag}
								href={`${withLang("/posts", lang)}?tag=${encodeURIComponent(tag)}`}
							>
								#{tag} <span class="text-muted">{count}</span>
							</a>
						</li>
					))
				}
			</ul>
		</aside>
	</div>
</PageLayout>

<style>
	.tag-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.4rem 0.8rem;
		border-radius: 9999px;
		background: var(--color-surface);
		color: var(--color-global-text);
		font-size: 0.75rem;
		line-height: 1;
		white-space: nowrap;
		cursor: pointer;
		transition:
			background 150ms,
			color 150ms;
	}
	@media (min-width: 1024px) {
		.tag-chip {
			padding: 0.3rem 0.75rem;
		}
	}
	.tag-filters {
		scrollbar-width: none;
		-webkit-overflow-scrolling: touch;
	}
	.tag-filters::-webkit-scrollbar {
		display: none;
	}
	.tag-chip:hover {
		background: color-mix(in oklch, var(--color-accent) 12%, var(--color-surface));
		color: var(--color-accent);
	}
	.tag-chip.is-active {
		background: var(--color-accent);
		color: var(--color-global-bg);
	}
	.tag-chip.is-active .text-muted {
		color: color-mix(in oklch, var(--color-global-bg) 70%, transparent);
	}
	.timeline-year {
		position: relative;
	}
	.timeline-row {
		display: grid;
		grid-template-columns: 3.5rem 1.1rem minmax(0, 1fr);
		column-gap: 0.55rem;
		align-items: start;
	}
	.timeline-posts {
		display: grid;
		gap: 0;
	}
	.timeline-item {
		padding-block: 0.65rem;
	}
	.timeline-year-heading {
		position: sticky;
		top: 3.5rem;
		z-index: 10;
		margin-bottom: 0.45rem;
		padding-block: 0.35rem 0.55rem;
		background: var(--color-global-bg);
	}
	@media (min-width: 640px) {
		.timeline-year-heading {
			top: 4rem;
		}
	}
	.timeline-node {
		position: relative;
		display: flex;
		min-height: 1.75rem;
		justify-content: center;
	}
	.timeline-node::before {
		content: "";
		position: absolute;
		top: -0.75rem;
		bottom: -0.75rem;
		width: 1px;
		background: color-mix(in oklch, var(--color-border) 78%, transparent);
	}
	.timeline-node::after {
		content: "";
		position: relative;
		z-index: 1;
		margin-top: 0.45rem;
		height: 0.38rem;
		width: 0.38rem;
		border-radius: 9999px;
		background: var(--color-accent);
		box-shadow: 0 0 0 3px var(--color-global-bg);
	}
	.timeline-item:first-child .timeline-node::before {
		top: 0.65rem;
	}
	.timeline-item:last-child .timeline-node::before {
		bottom: calc(100% - 0.65rem);
	}
	@media (min-width: 640px) {
		.timeline-row {
			grid-template-columns: 5.25rem 1.5rem minmax(0, 1fr);
		}
	}
	@media (min-width: 1024px) {
		.posts-tags {
			max-height: calc(100vh - 7rem);
			overflow: auto;
			padding-right: 0.15rem;
		}
	}
</style>

<script>
	const INITIAL = 20;
	const STEP = 20;
	let currentTag = "";
	let visibleCount = INITIAL;

	const list = document.getElementById("posts-list");
	const endEl = document.getElementById("posts-end");
	const emptyEl = document.getElementById("posts-empty");
	const sentinel = document.getElementById("scroll-sentinel");
	const filtersEl = document.getElementById("tag-filters");
	if (list && filtersEl && sentinel) {
		const items = Array.from(list.querySelectorAll<HTMLLIElement>(".post-item"));
		const groups = Array.from(list.querySelectorAll<HTMLElement>(".timeline-year"));

		function applyFilter() {
			const matched = items.filter((el) => {
				if (!currentTag) return true;
				const tags = (el.dataset.tags || "").split("|");
				return tags.includes(currentTag);
			});
			items.forEach((el) => (el.style.display = "none"));
			matched.slice(0, visibleCount).forEach((el) => (el.style.display = ""));
			groups.forEach((group) => {
				const hasVisiblePost = Array.from(group.querySelectorAll<HTMLLIElement>(".post-item")).some(
					(el) => el.style.display !== "none",
				);
				group.classList.toggle("hidden", !hasVisiblePost);
			});

			endEl?.classList.toggle("hidden", matched.length === 0 || visibleCount < matched.length);
			emptyEl?.classList.toggle("hidden", matched.length > 0);
		}

		function syncActiveChip() {
			filtersEl!.querySelectorAll<HTMLElement>(".tag-chip").forEach((el) => {
				el.classList.toggle("is-active", (el.dataset.tag || "") === currentTag);
			});
		}

		function readTagFromUrl() {
			return new URL(window.location.href).searchParams.get("tag") || "";
		}

		function setTag(tag: string, push: boolean) {
			currentTag = tag;
			visibleCount = INITIAL;
			if (push) {
				const url = new URL(window.location.href);
				if (tag) url.searchParams.set("tag", tag);
				else url.searchParams.delete("tag");
				history.pushState({ tag }, "", url.pathname + url.search + url.hash);
			}
			syncActiveChip();
			applyFilter();
		}

		filtersEl.addEventListener("click", (e) => {
			const target = e.target as HTMLElement;
			const link = target.closest<HTMLAnchorElement>("a.tag-chip");
			if (!link) return;
			const me = e as MouseEvent;
			if (me.metaKey || me.ctrlKey || me.shiftKey || me.altKey || me.button === 1) return;
			e.preventDefault();
			setTag(link.dataset.tag || "", true);
			window.scrollTo({ top: 0, behavior: "smooth" });
		});

		window.addEventListener("popstate", () => {
			setTag(readTagFromUrl(), false);
		});

		const io = new IntersectionObserver(
			(entries) => {
				if (!entries[0]?.isIntersecting) return;
				visibleCount += STEP;
				applyFilter();
			},
			{ rootMargin: "400px 0px" },
		);
		io.observe(sentinel);

		currentTag = readTagFromUrl();
		syncActiveChip();
		applyFilter();
	}
</script>
