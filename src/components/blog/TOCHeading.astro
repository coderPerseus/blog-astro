---
import type { TocItem } from "@/utils/generateToc";

interface Props {
	heading: TocItem;
}

const {
	heading: { children, depth, slug, text },
} = Astro.props;
---

<li class={`min-w-0 ${depth > 2 ? "ms-3" : ""}`}>
	<a
		class={`hover:text-accent data-[active=true]:text-accent block px-3 py-2 leading-snug break-words text-muted transition-colors ${depth <= 2 ? "text-sm font-semibold" : "text-xs"}`}
		data-active="false"
		href={`#${slug}`}>{text}</a
	>
	{
		!!children.length && (
			<ol class="mt-0.5 space-y-0.5">
				{children.map((subheading) => (
					<Astro.self heading={subheading} />
				))}
			</ol>
		)
	}
</li>
