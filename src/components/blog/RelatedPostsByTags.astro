---
import type { CollectionEntry } from "astro:content";
import { type Lang, t, withLang } from "@/utils/i18n";

type PostLike = CollectionEntry<"post"> | CollectionEntry<"postEn">;

interface Props {
	lang?: Lang;
	posts: PostLike[];
	tags: string[];
}

const { lang = "zh", posts, tags } = Astro.props;
---

{
	posts.length > 0 && (
		<section
			class="bg-surface/70 max-w-full min-w-0 rounded-lg p-3 shadow-[0_1px_0_color-mix(in_oklch,var(--color-global-text)_8%,transparent)] sm:p-4"
			aria-labelledby="related-posts-title"
		>
			<div class="mb-3 flex items-baseline justify-between gap-3 px-1">
				<h2 class="text-accent-2 text-sm font-semibold" id="related-posts-title">
					{t("posts.related_by_tag", lang)}
				</h2>
				<a
					class="text-muted hover:text-accent shrink-0 text-xs transition-colors"
					href={`${withLang("/posts", lang)}?tag=${encodeURIComponent(tags[0] ?? "")}`}
				>
					{t("posts.view_more_same_tag", lang)}
				</a>
			</div>
			<ul class="space-y-2" role="list">
				{posts.map((post) => (
					<li>
						<a
							class="group bg-global-bg/55 hover:bg-global-bg block min-w-0 rounded-md px-3 py-2.5 transition-[background-color,transform] active:scale-[0.99]"
							href={withLang(`/posts/${post.id}`, lang)}
							aria-label={post.data.title}
						>
							<span class="text-global-text group-hover:text-accent line-clamp-2 text-sm leading-snug font-medium transition-colors">
								{post.data.title}
							</span>
						</a>
					</li>
				))}
			</ul>
		</section>
	)
}
