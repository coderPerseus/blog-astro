---
import type { MarkdownHeading } from "astro";
import { generateToc } from "@/utils/generateToc";
import TOCHeading from "./TOCHeading.astro";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;

const toc = generateToc(headings);
---

<details open class="paper-panel p-5 lg:sticky lg:top-8 lg:order-2">
	<summary class="hover:marker:text-accent text-accent-2 cursor-pointer text-base font-semibold">
		目录
		<span class="text-muted ms-2 text-xs font-normal">Table of Contents</span>
	</summary>
	<nav class="ms-1 lg:w-full">
		<ol class="mt-4">
			{toc.map((heading) => <TOCHeading heading={heading} />)}
		</ol>
	</nav>
</details>
