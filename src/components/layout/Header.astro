---
import { Image } from "astro:assets";
import logo from "@/assets/logo.webp";
import LanguageToggle from "@/components/LanguageToggle.astro";
import Search from "@/components/Search.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { getMenuLinks, type Lang, stripLangFromPath, t, withLang } from "@/utils/i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const menuLinks = getMenuLinks(lang);
const currentPath = stripLangFromPath(Astro.url.pathname);
const homePath = withLang("/", lang);
const siteTitle = t("site.title", lang);
const navLabel = lang === "zh" ? "主导航" : "Primary navigation";
const mobileNavLabel = lang === "zh" ? "移动导航" : "Mobile navigation";
const isHome = currentPath === "/";
---

<header
	class="sticky top-0 z-40 border-b border-border/60 bg-global-bg/80 backdrop-blur-md"
	id="main-header"
>
	<div
		class="mx-auto flex h-14 w-full max-w-5xl items-center gap-4 px-5 sm:h-16 sm:px-8"
	>
		{
			isHome ? (
				<div
					aria-current="page"
					class="flex items-center gap-2.5 cursor-default"
				>
					<Image
						alt={`${siteTitle} Logo`}
						class="h-8 w-8 rounded-full"
						height={64}
						loading="eager"
						src={logo}
						width={64}
					/>
					<span class="hidden text-base font-semibold tracking-tight text-accent-2 sm:inline">
						{siteTitle}
					</span>
				</div>
			) : (
				<a class="flex items-center gap-2.5" href={homePath}>
					<Image
						alt={`${siteTitle} Logo`}
						class="h-8 w-8 rounded-full"
						height={64}
						loading="eager"
						src={logo}
						width={64}
					/>
					<span class="hidden text-base font-semibold tracking-tight text-accent-2 sm:inline">
						{siteTitle}
					</span>
				</a>
			)
		}

		<nav
			aria-label={navLabel}
			class="ms-4 hidden items-center gap-1 sm:flex"
			id="navigation-menu"
		>
			{
				menuLinks.map((link) => {
					const linkPath = stripLangFromPath(link.path);
					const normalizedLink = linkPath.replace(/\/$/, "") || "/";
					const normalizedCurrent = currentPath.replace(/\/$/, "") || "/";
					const isActive =
						linkPath === "/"
							? currentPath === "/"
							: currentPath.startsWith(linkPath.replace(/\/$/, ""));
					const isCurrentPage = normalizedCurrent === normalizedLink;
					if (isCurrentPage) {
						return (
							<span
								aria-current="page"
								class="rounded-md px-3 py-1.5 text-sm text-accent cursor-default"
							>
								{link.title}
							</span>
						);
					}
					return (
						<a
							class={`rounded-md px-3 py-1.5 text-sm transition-colors ${
								isActive
									? "text-accent"
									: "text-muted hover:text-accent-2"
							}`}
							href={link.path}
						>
							{link.title}
						</a>
					);
				})
			}
		</nav>

		<div class="ms-auto flex items-center gap-1">
			<Search lang={lang} />
			<ThemeToggle lang={lang} />
			<LanguageToggle lang={lang} />
			<mobile-button class="sm:hidden">
				<button
					aria-expanded="false"
					aria-haspopup="menu"
					class="group ms-1 inline-flex h-9 w-9 items-center justify-center rounded-md text-muted hover:bg-surface hover:text-accent-2"
					id="toggle-navigation-menu"
					type="button"
				>
					<span class="sr-only group-aria-expanded:hidden">
						{lang === "zh" ? "打开菜单" : "Open menu"}
					</span>
					<span class="sr-only hidden group-aria-expanded:inline">
						{lang === "zh" ? "关闭菜单" : "Close menu"}
					</span>
					<svg
						aria-hidden="true"
						class="block h-5 w-5 group-aria-expanded:hidden"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						viewBox="0 0 24 24"
						xmlns="http://www.w3.org/2000/svg"
					>
						<path
							d="M3.75 9h16.5m-16.5 6.75h16.5"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
					<svg
						aria-hidden="true"
						class="hidden h-5 w-5 group-aria-expanded:block"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						viewBox="0 0 24 24"
						xmlns="http://www.w3.org/2000/svg"
					>
						<path
							d="M6 18 18 6M6 6l12 12"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
				</button>
			</mobile-button>
		</div>
	</div>

	<nav
		aria-label={mobileNavLabel}
		class="hidden border-t border-border bg-global-bg sm:hidden group-[.menu-open]:flex group-[.menu-open]:flex-col"
		id="mobile-menu"
	>
		{
			menuLinks.map((link) => {
				const linkPath = stripLangFromPath(link.path);
				const normalizedLink = linkPath.replace(/\/$/, "") || "/";
				const normalizedCurrent = currentPath.replace(/\/$/, "") || "/";
				const isCurrentPage = normalizedCurrent === normalizedLink;
				if (isCurrentPage) {
					return (
						<span
							aria-current="page"
							class="border-b border-border/60 px-5 py-3 text-sm text-accent cursor-default"
						>
							{link.title}
						</span>
					);
				}
				return (
					<a
						class="border-b border-border/60 px-5 py-3 text-sm text-muted hover:text-accent"
						href={link.path}
					>
						{link.title}
					</a>
				);
			})
		}
	</nav>
</header>

<script>
	import { toggleClass } from "@/utils/domElement";

	class MobileNavBtn extends HTMLElement {
		#menuOpen: boolean = false;

		connectedCallback() {
			const headerEl = document.getElementById("main-header")!;
			const mobileButtonEl = this.querySelector<HTMLButtonElement>("button");
			const mobileMenuEl = document.getElementById("mobile-menu");

			mobileButtonEl?.addEventListener("click", () => {
				if (headerEl) toggleClass(headerEl, "menu-open");
				if (mobileMenuEl) {
					mobileMenuEl.classList.toggle("hidden");
					mobileMenuEl.classList.toggle("flex");
					mobileMenuEl.classList.toggle("flex-col");
				}
				this.#menuOpen = !this.#menuOpen;
				mobileButtonEl.setAttribute("aria-expanded", this.#menuOpen.toString());
			});
		}
	}

	customElements.define("mobile-button", MobileNavBtn);
</script>
